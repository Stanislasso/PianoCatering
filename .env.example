# Kopieer dit bestand naar ".env" en zet het BUITEN de webroot op de hosting
# (één niveau boven de site-root, of via een pad dat je in PIANOC_ENV_FILE
# opgeeft als PHP-environment-variabele in Plesk). Dit voorbeeld bevat enkel
# placeholders en mag in git; het echte .env-bestand niet.

# Afzender van de klantmails en de interne meldingen.
# Leeg = info@pianocatering.be / "Piano C Catering".
MAIL_FROM_EMAIL=info@pianocatering.be
MAIL_FROM_NAME=Piano C Catering

# Ontvangers van de interne meldmail bij een nieuwe aanvraag (komma-gescheiden).
# viktor@prettynicedough.be moet erbij: daar leest Sofie de aanvragen voor het
# Klantenbord. Voeg het adres van Piano A toe zodra bekend.
# Leeg = enkel viktor@prettynicedough.be.
NOTIFY_EMAILS=viktor@prettynicedough.be,viktor@decroos.be

# Optioneel: Google Distance Matrix voor de afstand. Leeg = Nominatim + OSRM,
# dezelfde gratis diensten als de configurator op de site.
GOOGLE_MAPS_API_KEY=

# Optioneel: pad van het CSV-vangnet. Leeg = één niveau boven de site-root.
PIANOC_LEAD_LOG=
